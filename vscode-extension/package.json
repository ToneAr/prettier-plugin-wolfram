{
	"name": "prettier-vscode-wolfram",
	"displayName": "Wolfram Prettier Plugin",
	"description": "Formats Wolfram Language files and surfaces formatter-backed diagnostics using bundled Prettier.",
	"version": "0.7.6",
	"license": "MIT",
	"publisher": "Tone",
	"icon": "assets/icon.png",
	"preview": true,
	"repository": {
		"type": "git",
		"url": "git://github.com/ToneAr/prettier-plugin-wolfram.git"
	},
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Formatters"
	],
	"activationEvents": [
		"onLanguage:wolfram",
		"onLanguage:wolframscript",
		"onLanguage:wolfram-notebook"
	],
	"main": "./src/extension.js",
	"scripts": {
		"package:standalone": "node ../scripts/package-vscode-extension.mjs",
		"package:pre-release": "node ../scripts/package-vscode-extension.mjs --pre-release",
		"publish:pre-release": "node ../scripts/package-vscode-extension.mjs --pre-release --publish"
	},
	"dependencies": {
		"prettier": "^3.4.0",
		"prettier-plugin-wolfram": "^0.7.6"
	},
	"contributes": {
		"configuration": {
			"title": "Prettier Wolfram",
			"properties": {
				"wolframPrettier.diagnosticSeverity": {
					"type": "string",
					"default": "information",
					"enum": [
						"information",
						"warning",
						"hint",
						"error"
					],
					"markdownDescription": "Severity used for formatter-backed diagnostics. `information` shows blue squiggles by default; `warning` is stronger; `hint` uses dotted underlines."
				}
			}
		},
		"jsonValidation": [
			{
				"fileMatch": [
					".prettierrc",
					".prettierrc.json",
					".prettierrc.json5"
				],
				"url": "./schemas/prettierrc.schema.json"
			}
		],
		"languages": [
			{
				"id": "wolfram",
				"aliases": [
					"Wolfram",
					"Wolfram Language"
				],
				"extensions": [
					".wl",
					".wls",
					".wlt",
					".m",
					".mt",
					".nb",
					".cdf",
					".vsnb"
				]
			}
		]
	}
}
